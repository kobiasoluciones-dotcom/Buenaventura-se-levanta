# Copia este archivo a .env y completa los valores reales. .env nunca se sube a Git.

PORT=3000

# Contrasena compartida del panel interno (/admin). Cambiarla rota la sesion
# de todos los que estaban logueados.
ADMIN_PASSWORD=

# Supabase (proyecto compartido — tablas con prefijo sismo_)
SUPABASE_URL=
# Settings -> API -> service_role (secreta). Nunca la "anon"/"public".
SUPABASE_SERVICE_ROLE_KEY=
