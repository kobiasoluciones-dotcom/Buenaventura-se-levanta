# Copia este archivo a .env y completa los valores reales. .env nunca se sube a Git.

PORT=3000

# Contrasena compartida del panel interno (/admin). Cambiarla rota la sesion
# de todos los que estaban logueados.
ADMIN_PASSWORD=

# Supabase (proyecto compartido — tablas con prefijo sismo_)
SUPABASE_URL=
# Settings -> API -> service_role (secreta). Nunca la "anon"/"public".
SUPABASE_SERVICE_ROLE_KEY=

# Portal público aprobado. La raíz del backend redirige aquí; /admin y /api
# siguen siendo atendidos por Express.
PUBLIC_SITE_URL=https://buenaventura-se-levanta.millerocoro.chatgpt.site

# Orígenes autorizados para consumir la API pública desde el navegador.
# Separa varios dominios con coma. En producción debe incluir PUBLIC_SITE_URL.
ALLOWED_ORIGINS=https://buenaventura-se-levanta.millerocoro.chatgpt.site
